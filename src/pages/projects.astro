---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = allProjects.find((p) => p.data.featured);
const rest = allProjects.filter((p) => !p.data.featured);
---

<Base
  title="Projects"
  description="Bots, apps, and on-chain tools. Some for clients, some for myself, all shipped."
>
  <section class="intro container">
    <p class="mono-label">Projects</p>
    <h1 class="intro-title">Things I've built,<br />and am building.</h1>
    <p class="intro-sub">
      Bots, apps, and on-chain tools. Some for clients, some for myself, all
      shipped.
    </p>
  </section>

  {
    featured && (
      <section class="feature-section container">
        <article class="feature-card">
          <div class="feature-text">
            <div class="pill-row">
              <span class="pill pill-solid">{featured.data.status}</span>
              <span class="pill pill-outline">{featured.data.category}</span>
              <span class="pill pill-outline">Solana</span>
            </div>
            <h2 class="feature-title">{featured.data.title}</h2>
            <p class="feature-desc">{featured.data.description}</p>
            <a href="/contact" class="btn btn-solid feature-btn">Get early access</a>
          </div>
          <div class="feature-image">
            {featured.data.image ? (
              <img src={featured.data.image} alt={`${featured.data.title} logo`} />
            ) : (
              <img src="/images/copybot-logo.jpg" alt={`${featured.data.title} logo`} />
            )}
          </div>
        </article>
      </section>
    )
  }

  <section class="grid-section container">
    <div class="projects-grid">
      {
        rest.map((project) => (
          <article class="project-card">
            <div class="project-image">
              {project.data.image ? (
                <img src={project.data.image} alt={project.data.title} />
              ) : (
                <span class="placeholder-label">[Image]</span>
              )}
            </div>
            <div class="project-body">
              <span class="mono-label project-category">{project.data.category}</span>
              <h3 class="project-name">{project.data.title}</h3>
              <p class="project-desc">{project.data.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-top: 96px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .intro-title {
    font-size: clamp(44px, 6vw, 80px);
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 700;
  }

  .intro-sub {
    max-width: 600px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
  }

  .feature-section {
    padding-bottom: 64px;
  }

  .feature-card {
    border: 1px solid var(--ink);
    border-radius: var(--radius-lg);
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
  }

  .feature-text {
    flex: 1 1 460px;
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 6px 12px;
  }

  .pill-solid {
    background: var(--ink);
    color: var(--bg);
  }

  .pill-outline {
    border: 1px solid var(--chip);
  }

  .feature-title {
    font-size: 56px;
    letter-spacing: -0.04em;
    font-weight: 700;
  }

  .feature-desc {
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }

  .feature-btn {
    align-self: flex-start;
    padding: 14px 22px;
    font-size: 15px;
  }

  .feature-image {
    flex: 1 1 460px;
    min-height: 320px;
    background: var(--surface);
    border-left: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .feature-image img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
    display: block;
  }

  .grid-section {
    padding-bottom: 120px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .project-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project-image {
    height: 200px;
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .project-body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .project-category {
    font-size: 12px;
  }

  .project-name {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .project-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
