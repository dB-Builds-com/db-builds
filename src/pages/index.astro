---
import Base from '../layouts/Base.astro';
---

<Base
  title="Home"
  description="Independent developer building trading bots, web apps, and Solana tooling, from the first sketch to the shipped product."
>
  <section class="hero container">
    <p class="mono-label">Independent developer · dB</p>
    <h1 class="hero-title">Ideas in.<br />Products out.</h1>
    <p class="hero-sub">
      Trading bots, web apps, and Solana tooling, designed and built from the
      first sketch to the shipped product.
    </p>
    <div class="hero-actions">
      <a href="/projects" class="btn btn-solid">See the work</a>
      <a href="/contact" class="btn btn-outline">Start a project</a>
    </div>
  </section>

  <section class="section section-bordered">
    <div class="container section-inner">
      <div class="section-head">
        <h2 class="h2">What I build</h2>
        <a href="/services" class="link-arrow">All services →</a>
      </div>
      <div class="build-grid">
        <div class="build-cell">
          <span class="mono-num">01</span>
          <h3 class="h3">Trading bots &amp; automation</h3>
          <p class="cell-text">
            Rule-based bots that watch the market and act for you, with the
            rules in your hands.
          </p>
        </div>
        <div class="build-cell">
          <span class="mono-num">02</span>
          <h3 class="h3">Websites &amp; web apps</h3>
          <p class="cell-text">
            Fast, clean sites and full-stack apps, from landing pages to
            tools people use every day.
          </p>
        </div>
        <div class="build-cell">
          <span class="mono-num">03</span>
          <h3 class="h3">Solana &amp; token tooling</h3>
          <p class="cell-text">
            Token analysis, launch tooling, and on-chain mechanics for
            projects building on Solana.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-bordered">
    <div class="container section-inner">
      <div class="section-head">
        <h2 class="h2">Featured project</h2>
        <a href="/projects" class="link-arrow">All projects →</a>
      </div>
      <div class="feature-card">
        <div class="feature-text">
          <span class="pill pill-outline">In development</span>
          <h3 class="feature-title">CopyBot</h3>
          <p class="feature-desc">
            A copy trading bot that follows the wallets you choose and
            trades by your rules. Set the conditions, sizes, and limits;
            CopyBot handles the rest.
          </p>
          <a href="/projects" class="btn btn-solid feature-btn">Follow the build</a>
        </div>
        <div class="feature-image">
          <img src="/images/copybot-logo.jpg" alt="CopyBot logo" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section-bordered">
    <div class="container section-inner">
      <h2 class="h2">How it goes</h2>
      <div class="steps-grid">
        <div class="step">
          <span class="mono-num">01 · Idea</span>
          <p class="step-text">
            You bring the rough idea. We figure out what it really needs to
            do.
          </p>
        </div>
        <div class="step">
          <span class="mono-num">02 · Plan</span>
          <p class="step-text">
            Architecture and scope get mapped out before any code is
            written.
          </p>
        </div>
        <div class="step">
          <span class="mono-num">03 · Build</span>
          <p class="step-text">
            Built in short iterations, so you see real progress early.
          </p>
        </div>
        <div class="step">
          <span class="mono-num">04 · Ship</span>
          <p class="step-text">
            Launched, tested, and handed over, or kept running for you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <h2 class="cta-title">Got an idea?<br />Let's ship it.</h2>
      <a href="/contact" class="btn btn-solid-inverted cta-btn">Start a project</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 128px;
    padding-bottom: 112px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .hero-title {
    font-size: clamp(56px, 9vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 700;
  }

  .hero-sub {
    max-width: 620px;
    font-size: 21px;
    line-height: 1.5;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }

  .section-bordered {
    border-top: 1px solid var(--line);
  }

  .section-inner {
    padding-top: 96px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
  }

  .h2 {
    font-size: 40px;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .h3 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .link-arrow {
    font-size: 15px;
    text-decoration: none;
  }

  .build-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .build-cell {
    background: var(--bg);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .mono-num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .cell-text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  .feature-card {
    border: 1px solid var(--ink);
    border-radius: var(--radius-lg);
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
  }

  .feature-text {
    flex: 1 1 420px;
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pill {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 6px 12px;
  }

  .pill-outline {
    border: 1px solid var(--ink);
  }

  .feature-title {
    font-size: 48px;
    letter-spacing: -0.04em;
    font-weight: 700;
  }

  .feature-desc {
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }

  .feature-btn {
    align-self: flex-start;
    padding: 14px 22px;
    font-size: 15px;
  }

  .feature-image {
    flex: 1 1 420px;
    min-height: 320px;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .feature-image img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: contain;
    display: block;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 2px solid var(--ink);
    padding-top: 20px;
  }

  .step-text {
    font-size: 16px;
    line-height: 1.6;
  }

  .cta-band {
    background: var(--ink);
    color: var(--bg);
  }

  .cta-inner {
    padding-top: 112px;
    padding-bottom: 112px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
  }

  .cta-title {
    font-size: clamp(36px, 5vw, 64px);
    letter-spacing: -0.04em;
    font-weight: 700;
    line-height: 1.05;
  }

  .cta-btn {
    padding: 18px 28px;
    font-weight: 600;
    font-size: 17px;
  }
</style>
