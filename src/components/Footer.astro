---
import { social } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <span>© {year} dB Builds</span>
    <div class="footer-links">
      <a href={social.x.url}>X</a>
      <a href={social.telegram.url}>Telegram</a>
      <a href={social.discord.url}>Discord</a>
      <a href={social.github.url}>GitHub</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .footer-inner {
    padding-top: 40px;
    padding-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    font-size: 14px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer-links a {
    color: var(--muted);
  }
</style>
